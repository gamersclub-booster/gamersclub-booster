# ============================================================
# npm security configuration
# ============================================================

# --- Supply chain / dependency security ---

# Run `npm audit` on installs (default true, kept explicit).
audit=true

# Fail installs/audits only on high or critical vulnerabilities.
# Tighten to `moderate` or `low` for stricter checks.
audit-level=high

# Always create/update the lockfile (default true, kept explicit).
package-lock=true

# Pin the official npm registry (default, kept explicit).
registry=https://registry.npmjs.org/

# Enforce TLS for all registry traffic (default true, kept explicit).
strict-ssl=true

# Save new dependencies with exact versions (no ^ or ~ ranges) so
# installs are reproducible and never silently upgraded.
save-exact=true

# Minimum age (in days) of a package release before it can be
# installed. Blocks brand-new releases that may be malicious.
# Requires npm >= 11 (see `engines` in package.json).
min-release-age=5

# --- Execution / lifecycle hardening ---

# Do not run lifecycle scripts (preinstall/postinstall/...) of
# dependencies. NOTE: this also disables this project's own
# `prepare` script (husky). After a fresh clone, run `npx husky`
# once to re-enable the git hooks.
ignore-scripts=true

# Fail installs when the local Node/npm version does not satisfy
# the `engines` field in package.json.
engine-strict=true
